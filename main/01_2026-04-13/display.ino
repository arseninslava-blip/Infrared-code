uint8_t displayBuffer[BUFFER_SIZE];

// ==================== SOFT I2C ====================
void setSCL(bool level) { digitalWrite(SCL_PIN, level); }
void setSDA(bool level) { digitalWrite(SDA_PIN, level); }

void i2c_init() {
  pinMode(SCL_PIN, OUTPUT);
  pinMode(SDA_PIN, OUTPUT);
  setSCL(HIGH);
  setSDA(HIGH);
}

void i2c_start() {
  setSDA(HIGH);
  setSCL(HIGH);
  delayMicroseconds(5);
  setSDA(LOW);
  delayMicroseconds(5);
  setSCL(LOW);
}

void i2c_stop() {
  setSDA(LOW);
  setSCL(HIGH);
  delayMicroseconds(5);
  setSDA(HIGH);
}

void i2c_write_byte(uint8_t byte) {
  for (int i = 7; i >= 0; i--) {
    setSCL(LOW);
    setSDA((byte >> i) & 1);
    delayMicroseconds(2);
    setSCL(HIGH);
    delayMicroseconds(3);
    setSCL(LOW);
  }
  setSCL(LOW);
  pinMode(SDA_PIN, INPUT_PULLUP);
  setSCL(HIGH);
  delayMicroseconds(2);
  setSCL(LOW);
  pinMode(SDA_PIN, OUTPUT);
}

void sendCommand(uint8_t cmd) {
  i2c_start();
  i2c_write_byte((OLED_ADDR << 1) | 0);
  i2c_write_byte(0x00);
  i2c_write_byte(cmd);
  i2c_stop();
}

void sendDataBuffer() {
  i2c_start();
  i2c_write_byte((OLED_ADDR << 1) | 0);
  i2c_write_byte(0x40);
  for (uint16_t i = 0; i < BUFFER_SIZE; i++) {
    i2c_write_byte(displayBuffer[i]);
  }
  i2c_stop();
}

void buffer_clear() {
  memset(displayBuffer, 0, BUFFER_SIZE);
}

void setPixel(uint8_t x, uint8_t y, bool color) {
  if (x >= 128 || y >= 64) return;
  uint16_t index = (y / 8) * 128 + x;
  if (color) displayBuffer[index] |= (1 << (y % 8));
  else displayBuffer[index] &= ~(1 << (y % 8));
}

void drawString(uint8_t x, uint8_t y, const char* str, bool color = true) {
  uint8_t cx = x;
  while (*str) {
    if (*str >= 32 && *str <= 126) {
      const uint8_t* ch = font5x7[*str - 32];
      for (int col = 0; col < 5; col++) {
        uint8_t bits = pgm_read_byte(&ch[col]);
        for (int row = 0; row < 7; row++) {
          if (bits & (1 << row)) setPixel(cx + col, y + row, color);
        }
      }
    }
    cx += 6;
    str++;
  }
}

void drawRect(uint8_t x, uint8_t y, uint8_t w, uint8_t h, bool color, bool filled) {
  if (filled) {
    for (uint8_t i = y; i < y + h; i++)
      for (uint8_t j = x; j < x + w; j++)
        setPixel(j, i, color);
  } else {
    for (uint8_t i = 0; i < w; i++) {
      setPixel(x + i, y, color);
      setPixel(x + i, y + h - 1, color);
    }
    for (uint8_t i = 0; i < h; i++) {
      setPixel(x, y + i, color);
      setPixel(x + w - 1, y + i, color);
    }
  }
}

void display() {
  sendCommand(0x21);
  sendCommand(0x00);
  sendCommand(0x7F);
  sendCommand(0x22);
  sendCommand(0x00);
  sendCommand(0x07);
  sendDataBuffer();
}

